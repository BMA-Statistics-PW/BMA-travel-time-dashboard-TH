diff --git a/assets/dashboard-shell.css b/assets/dashboard-shell.css
index 480bb29..a7bfdd7 100644
--- a/assets/dashboard-shell.css
+++ b/assets/dashboard-shell.css
@@ -432,8 +432,10 @@ html{scroll-padding-top:calc(var(--tb-h) + 16px)}
 .rt-empty { padding: 24px; text-align: center; color: var(--d-muted, #64748b); }
 
 /* กราฟแท่งแนวตั้ง: แนวโน้มอัตราเร็วเฉลี่ยรายปี */
-.bars.vbars{flex-direction:row;align-items:flex-end;gap:6px;overflow-x:auto;padding:4px 2px 8px}
+.bars.vbars{flex-direction:row;align-items:flex-start;gap:6px;overflow-x:auto;padding:4px 2px 8px}
 .vbar-col{flex:1 1 0;min-width:44px;display:flex;flex-direction:column;align-items:center;gap:6px;text-align:center}
+.vbar-tag{display:flex;align-items:center;justify-content:center;min-height:22px}
+.vbar-tag .tag{white-space:nowrap;font-size:11.5px;padding:1px 6px}
 .vbar-v{font-size:13px;font-variant-numeric:tabular-nums}
 .vbar-track{position:relative;width:100%;max-width:56px;height:220px;display:flex;align-items:flex-end;border-radius:10px 10px 4px 4px;background:var(--d-line);overflow:hidden}
 .vbar-fill{width:100%;height:var(--h,0);border-radius:10px 10px 0 0;background:var(--d-brand);transition:height .6s cubic-bezier(.4,0,.2,1)}
@@ -441,6 +443,10 @@ html{scroll-padding-top:calc(var(--tb-h) + 16px)}
 .vbar-fill.z-middle{background:var(--zc-middle)}
 .vbar-fill.z-outer{background:var(--zc-outer)}
 .vbar-y{font-weight:700;font-size:13px}
-.vbar-d{font-size:11px;min-height:20px}
+.vbar-d{font-size:11px;min-height:24px;display:flex;justify-content:center;max-width:100%}
+.vbar-d .badge{font-size:11.5px;padding:2px 6px;gap:2px}
+.bars.vbars{container-type:inline-size}
+@container (max-width:780px){.vbar-d .badge svg{display:none}.vbar-d .badge{padding:2px 4px;font-size:11px}}
+@container (max-width:560px){.vbar-d .badge{font-size:10px;padding:2px 2px;letter-spacing:-.2px}}
 .cmp-split{display:flex;flex-wrap:wrap;gap:6px;justify-content:center}
 @media (max-width:560px){.vbar-track{height:170px}.vbar-col{min-width:40px}}
