         <b class="vbar-v">${fmt(r[key])}</b>
         <div class="vbar-track" role="img" aria-label="${yr(r.year)}: ${fmt(r[key])} ${t('unitKmh')}"><div class="vbar-fill z-${S.zone}" data-h="${(r[key] / mx * 100).toFixed(1)}"></div></div>
         <span class="vbar-y">${yr(r.year)}</span>
